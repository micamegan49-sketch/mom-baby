# macOS
.DS_Store

# โฟลเดอร์ขยะที่ python/เครื่องมือ build สร้างโดยตั้ง HOME เป็น temp UUID
# (เคยมี <uuid>/Library/Caches/... หลุดเข้ารีโป)
*/Library/Caches/
__pycache__/
*.pyc

# ไฟล์สำรองข้อมูลที่ส่งออกจากแอพ (ข้อมูลส่วนตัวของผู้ใช้)
tuajiw-backup-*.json

# logs
*.log

# สคริปต์ชั่วคราว (setup/build เครื่องมือ — ไม่ต้องเก็บในรีโป)
scratch-*.sh

# Node / Capacitor
node_modules/
www/

# Xcode / iOS build artifacts (โปรเจกต์ ios/ เก็บไว้ แต่ไม่เก็บไฟล์ build)
ios/App/build/
ios/App/App/public/
ios/DerivedData/
DerivedData/
**/xcuserdata/
*.xcuserstate

# Android build artifacts (โปรเจกต์ android/ เก็บไว้ แต่ไม่เก็บไฟล์ build)
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/local.properties
android/.idea/
android/capacitor-cordova-android-plugins/
# 🔐 ห้าม commit keystore/รหัสเซ็นแอป/คีย์ API เด็ดขาด (เก็บไว้ที่ปลอดภัย สำรองหลายที่)
*.keystore
*.jks
keystore.properties
*.p8
AuthKey_*.p8
.env
.env.*
signing/

# เครื่องมือส่งสโตร์ (มีรหัสบัญชีเดโม/คีย์ ID — ห้ามขึ้น repo สาธารณะ)
scratchpad/
